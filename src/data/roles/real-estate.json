  "faq": [
    {
      "q": "Do you charge brokerage on new projects?",
      "a": "No, hum directly reputed builders se tied up hain, so for new project bookings (primary sales), zero brokerage is charged from the buyer."
    },
    {
      "q": "What is your commission for resale flats?",
      "a": "For resale and secondary market, standard 1% commission apply hota hai on the final deal value, payable at the time of registration."
    },
    {
      "q": "Will you assist with the home loan process?",
      "a": "Yes! Humare in-house loan experts sabhi major banks (SBI, HDFC, ICICI) ke process handle karte hain to ensure fastest processing at best rates."
    },
    {
      "q": "Kya aap tenant verification bhi karte ho rentals ke liye?",
      "a": "Bilkul. Police verification aur registered rent agreement ka poora end-to-end process hamari team manage karti hai."
    }
  ],
